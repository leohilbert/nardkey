KBD	nardkey	"NardKey - US with German umlauts"

COPYRIGHT	"(c) 2026 Leo Hilbert"

COMPANY	"Leo Hilbert"

LOCALENAME	"en-US"

LOCALEID	"00000409"

VERSION	1.0

// US layout (kbdus) plus German umlauts on scancodes an ANSI keyboard does not
// physically have. Firmware sends them for a chord (e.g. left Ctrl + left Alt + A),
// so applications receive a plain character and never see Ctrl/Alt.
//
//   SC  HID usage          QMK keycode   Char
//   56  0x64 Non-US \|     KC_NUBS       ä Ä
//   73  0x87 Intl1 (Ro)    KC_INT1       ö Ö
//   7d  0x89 Intl3 (Yen)   KC_INT3       ü Ü
//   7e  0x85 Keypad Comma  KC_KP_COMMA   ß ẞ
//   70  0x88 Intl2 (Kana)  KC_INT2       € €
//
// kbdutool only knows a few VK names and the free ones misbehave (Windows types "00"
// for ICO_00, nothing for SEPARATOR), so 0x70 is written as ICO_00 here and build.ps1
// rewrites that VK to OEM_AX in the compiled DLL.
//
// The umlauts and € are also on AltGr + A/O/U/S/E (EurKEY style) so the layout works
// on any keyboard without custom firmware.
//
// Build with build.ps1 / install with install.ps1, not MSKLC's "Build DLL and Setup
// Package": MSKLC 1.4 crashes there whenever kbdutool prints a warning (missing
// AlertBuildSuccessNotifyWithWarnings resource), and 0x7D always warns.

SHIFTSTATE

0	//Column 4
1	//Column 5 : Shft
2	//Column 6 :       Ctrl
6	//Column 7 :       Ctrl Alt
7	//Column 8 : Shft  Ctrl Alt

LAYOUT		;an extra '@' at the end is a dead key

//SC	VK_		Cap	0	1	2	6	7
//--	----		----	----	----	----	----	----

02	1		0	1	0021	-1	-1	-1		// 1 !
03	2		0	2	0040	-1	-1	-1		// 2 @
04	3		0	3	0023	-1	-1	-1		// 3 #
05	4		0	4	0024	-1	-1	-1		// 4 $
06	5		0	5	0025	-1	-1	-1		// 5 %
07	6		0	6	005e	-1	-1	-1		// 6 ^
08	7		0	7	0026	-1	-1	-1		// 7 &
09	8		0	8	002a	-1	-1	-1		// 8 *
0a	9		0	9	0028	-1	-1	-1		// 9 (
0b	0		0	0	0029	-1	-1	-1		// 0 )
0c	OEM_MINUS	0	002d	005f	-1	-1	-1		// - _
0d	OEM_PLUS	0	003d	002b	-1	-1	-1		// = +
10	Q		1	q	Q	-1	-1	-1
11	W		1	w	W	-1	-1	-1
12	E		1	e	E	-1	20ac	-1		// AltGr: €
13	R		1	r	R	-1	-1	-1
14	T		1	t	T	-1	-1	-1
15	Y		1	y	Y	-1	-1	-1
16	U		5	u	U	-1	00fc	00dc		// AltGr: ü Ü
17	I		1	i	I	-1	-1	-1
18	O		5	o	O	-1	00f6	00d6		// AltGr: ö Ö
19	P		1	p	P	-1	-1	-1
1a	OEM_4		0	005b	007b	001b	-1	-1		// [ {
1b	OEM_6		0	005d	007d	001d	-1	-1		// ] }
1e	A		5	a	A	-1	00e4	00c4		// AltGr: ä Ä
1f	S		1	s	S	-1	00df	00df		// AltGr: ß
20	D		1	d	D	-1	-1	-1
21	F		1	f	F	-1	-1	-1
22	G		1	g	G	-1	-1	-1
23	H		1	h	H	-1	-1	-1
24	J		1	j	J	-1	-1	-1
25	K		1	k	K	-1	-1	-1
26	L		1	l	L	-1	-1	-1
27	OEM_1		0	003b	003a	-1	-1	-1		// ; :
28	OEM_7		0	0027	0022	-1	-1	-1		// ' "
29	OEM_3		0	0060	007e	-1	-1	-1		// ` ~
2b	OEM_5		0	005c	007c	001c	-1	-1		// \ |
2c	Z		1	z	Z	-1	-1	-1
2d	X		1	x	X	-1	-1	-1
2e	C		1	c	C	-1	-1	-1
2f	V		1	v	V	-1	-1	-1
30	B		1	b	B	-1	-1	-1
31	N		1	n	N	-1	-1	-1
32	M		1	m	M	-1	-1	-1
33	OEM_COMMA	0	002c	003c	-1	-1	-1		// , <
34	OEM_PERIOD	0	002e	003e	-1	-1	-1		// . >
35	OEM_2		0	002f	003f	-1	-1	-1		// / ?
39	SPACE		0	0020	0020	0020	-1	-1
53	DECIMAL		0	002e	002e	-1	-1	-1		// Numpad .
56	OEM_102		1	00e4	00c4	-1	-1	-1		// ä Ä
73	ABNT_C1		1	00f6	00d6	-1	-1	-1		// ö Ö
7d	OEM_8		1	00fc	00dc	-1	-1	-1		// ü Ü
7e	ABNT_C2		0	00df	1e9e	-1	-1	-1		// ß ẞ
70	ICO_00		0	20ac	20ac	-1	-1	-1		// € € (build.ps1 patches the VK to OEM_AX, see there)

